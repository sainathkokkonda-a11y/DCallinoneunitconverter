<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>All-in-One Unit Converter</title>
  
  <style>
    :root {
      --primary-blue: #1565c0;
      --header-blue: #1155ab;
      --light-bg: #e8f4fe;
      --border-blue: #90caf9;
      --text-color: #0d47a1;
      --dark-text: #1a237e;
    }

    * {
      box-sizing: border-box;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background-color: #f4f7fa;
      margin: 0;
      padding: 12px;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }

    .converter-card {
      width: 100%;
      max-width: 650px;
      background: #ffffff;
      border: 2px solid var(--primary-blue);
      border-radius: 16px;
      box-shadow: 0 8px 25px rgba(21, 101, 192, 0.12);
      overflow: hidden;
    }

    .header-box {
      background: var(--header-blue);
      color: #ffffff;
      padding: 20px 16px;
      text-align: center;
    }

    .header-box h2 {
      margin: 0;
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.3px;
    }

    .header-box p {
      margin: 5px 0 0 0;
      font-size: 13px;
      opacity: 0.9;
    }

    .form-body {
      padding: 20px 16px;
    }

    .input-group {
      margin-bottom: 14px;
    }

    .input-group label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-color);
      margin-bottom: 6px;
    }

    .custom-input, .custom-select {
      width: 100%;
      padding: 12px;
      font-size: 14px;
      font-weight: 600;
      color: var(--dark-text);
      background-color: #ffffff;
      border: 1.5px solid var(--border-blue);
      border-radius: 8px;
      outline: none;
      transition: all 0.2s ease;
    }

    .custom-select {
      cursor: pointer;
    }

    .custom-input:focus, .custom-select:focus {
      border-color: var(--primary-blue);
      box-shadow: 0 0 0 3px rgba(21, 101, 192, 0.15);
    }

    .conversion-grid {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 10px;
      align-items: end;
      margin-bottom: 16px;
    }

    .swap-btn {
      background: var(--light-bg);
      border: 1.5px solid var(--border-blue);
      color: var(--primary-blue);
      width: 44px;
      height: 44px;
      border-radius: 50%;
      font-size: 18px;
      font-weight: bold;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 2px;
      transition: all 0.2s ease;
    }

    .swap-btn:hover {
      background: var(--primary-blue);
      color: #ffffff;
    }

    .result-box {
      background: var(--light-bg);
      border: 1.5px solid var(--border-blue);
      border-radius: 12px;
      padding: 16px;
      text-align: center;
      margin-top: 10px;
      position: relative;
    }

    .result-title {
      font-size: 12px;
      font-weight: 600;
      color: var(--text-color);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .result-value {
      font-size: 24px;
      font-weight: 800;
      color: var(--dark-text);
      margin: 8px 0 4px 0;
      word-break: break-all;
    }

    .formula-text {
      font-size: 12px;
      color: #555;
      font-style: italic;
    }

    .btn-group {
      display: flex;
      gap: 10px;
      margin-top: 16px;
    }

    .btn-copy {
      flex: 1;
      padding: 12px;
      background: var(--primary-blue);
      color: #ffffff;
      border: none;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.2s ease;
    }

    .btn-copy:hover {
      background: var(--header-blue);
    }

    .btn-reset {
      flex: 1;
      padding: 12px;
      background: #e53935;
      color: #ffffff;
      border: none;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
    }

    /* Mobile Responsive Rules */
    @media (max-width: 580px) {
      body {
        padding: 0px;
      }

      .conversion-grid {
        grid-template-columns: 1fr;
        gap: 8px;
      }

      .swap-btn {
        margin: 4px auto;
        transform: rotate(90deg);
      }

      .swap-btn:hover {
        transform: rotate(90deg) scale(1.1);
      }

      .header-box h2 {
        font-size: 20px;
      }

      .result-value {
        font-size: 20px;
      }
    }
  </style>
</head>
<body>

<div class="converter-card">
  <div class="header-box">
    <h2>All-in-One Unit Converter</h2>
    <p>Convert units easily across multiple categories</p>
  </div>

  <div class="form-body">
    
    <!-- Category Selector -->
    <div class="input-group">
      <label for="category">Select Category</label>
      <select id="category" class="custom-select" onchange="loadUnits()">
        <option value="length">Length / Distance</option>
        <option value="weight">Weight / Mass</option>
        <option value="temperature">Temperature</option>
        <option value="area">Area</option>
        <option value="volume">Volume</option>
        <option value="speed">Speed</option>
        <option value="time">Time</option>
        <option value="data">Data Storage</option>
        <option value="energy">Energy</option>
        <option value="pressure">Pressure</option>
      </select>
    </div>

    <!-- Input Value -->
    <div class="input-group">
      <label for="inputValue">Enter Value</label>
      <input type="number" id="inputValue" class="custom-input" value="1" placeholder="Enter number..." oninput="convert()">
    </div>

    <!-- From and To Selectors -->
    <div class="conversion-grid">
      <div class="input-group" style="margin: 0;">
        <label for="fromUnit">From</label>
        <select id="fromUnit" class="custom-select" onchange="convert()"></select>
      </div>

      <button class="swap-btn" onclick="swapUnits()" title="Swap Units">⇆</button>

      <div class="input-group" style="margin: 0;">
        <label for="toUnit">To</label>
        <select id="toUnit" class="custom-select" onchange="convert()"></select>
      </div>
    </div>

    <!-- Result Display -->
    <div class="result-box">
      <div class="result-title">Converted Result</div>
      <div class="result-value" id="resultValue">0</div>
      <div class="formula-text" id="formulaText">Select units to see formula</div>
    </div>

    <!-- Buttons -->
    <div class="btn-group">
      <button class="btn-reset" onclick="resetAll()">Reset</button>
      <button class="btn-copy" id="copyBtn" onclick="copyResult()">Copy Result</button>
    </div>

  </div>
</div>

<script>
  const unitData = {
    length: {
      meter: 1,
      kilometer: 1000,
      centimeter: 0.01,
      millimeter: 0.001,
      mile: 1609.344,
      yard: 0.9144,
      foot: 0.3048,
      inch: 0.0254
    },
    weight: {
      kilogram: 1,
      gram: 0.001,
      milligram: 0.000001,
      metric_ton: 1000,
      pound: 0.45359237,
      ounce: 0.028349523125
    },
    area: {
      square_meter: 1,
      square_kilometer: 1000000,
      square_foot: 0.09290304,
      square_mile: 2589988.11,
      acre: 4046.85642,
      hectare: 10000
    },
    volume: {
      liter: 1,
      milliliter: 0.001,
      cubic_meter: 1000,
      gallon_us: 3.78541,
      quart_us: 0.946353,
      pint_us: 0.473176,
      cup: 0.24
    },
    speed: {
      mps: 1, // Meter per second
      kph: 0.277778, // Km per hour
      mph: 0.44704, // Miles per hour
      knot: 0.514444
    },
    time: {
      second: 1,
      minute: 60,
      hour: 3600,
      day: 86400,
      week: 604800,
      month: 2628000,
      year: 31536000
    },
    data: {
      byte: 1,
      kilobyte: 1024,
      megabyte: 1048576,
      gigabyte: 1073741824,
      terabyte: 1099511627776
    },
    energy: {
      joule: 1,
      kilojoule: 1000,
      calorie: 4.184,
      kilocalorie: 4184,
      watt_hour: 3600,
      kilowatt_hour: 3600000
    },
    pressure: {
      pascal: 1,
      kilopascal: 1000,
      bar: 100000,
      psi: 6894.76,
      atmosphere: 101325
    }
  };

  const unitLabels = {
    meter: "Meter (m)", kilometer: "Kilometer (km)", centimeter: "Centimeter (cm)", millimeter: "Millimeter (mm)",
    mile: "Mile (mi)", yard: "Yard (yd)", foot: "Foot (ft)", inch: "Inch (in)",
    kilogram: "Kilogram (kg)", gram: "Gram (g)", milligram: "Milligram (mg)", metric_ton: "Metric Ton (t)",
    pound: "Pound (lb)", ounce: "Ounce (oz)",
    square_meter: "Square Meter (m²)", square_kilometer: "Square Kilometer (km²)", square_foot: "Square Foot (ft²)",
    square_mile: "Square Mile (mi²)", acre: "Acre", hectare: "Hectare",
    liter: "Liter (L)", milliliter: "Milliliter (mL)", cubic_meter: "Cubic Meter (m³)", gallon_us: "Gallon (US gal)",
    quart_us: "Quart (US qt)", pint_us: "Pint (US pt)", cup: "Cup",
    mps: "Meters per sec (m/s)", kph: "Km per hour (km/h)", mph: "Miles per hour (mph)", knot: "Knot (kn)",
    second: "Second (s)", minute: "Minute (min)", hour: "Hour (h)", day: "Day (d)", week: "Week (wk)", month: "Month", year: "Year (yr)",
    byte: "Byte (B)", kilobyte: "Kilobyte (KB)", megabyte: "Megabyte (MB)", gigabyte: "Gigabyte (GB)", terabyte: "Terabyte (TB)",
    joule: "Joule (J)", kilojoule: "Kilojoule (kJ)", calorie: "Calorie (cal)", kilocalorie: "Kilocalorie (kcal)", watt_hour: "Watt-hour (Wh)", kilowatt_hour: "Kilowatt-hour (kWh)",
    pascal: "Pascal (Pa)", kilopascal: "Kilopascal (kPa)", bar: "Bar", psi: "PSI (lb/in²)", atmosphere: "Atmosphere (atm)"
  };

  function loadUnits() {
    const cat = document.getElementById('category').value;
    const fromSelect = document.getElementById('fromUnit');
    const toSelect = document.getElementById('toUnit');
    
    fromSelect.innerHTML = '';
    toSelect.innerHTML = '';

    if (cat === 'temperature') {
      const tempUnits = [
        { key: 'celsius', name: 'Celsius (°C)' },
        { key: 'fahrenheit', name: 'Fahrenheit (°F)' },
        { key: 'kelvin', name: 'Kelvin (K)' }
      ];
      tempUnits.forEach(u => {
        fromSelect.add(new Option(u.name, u.key));
        toSelect.add(new Option(u.name, u.key));
      });
      toSelect.selectedIndex = 1;
    } else {
      const units = unitData[cat];
      let keys = Object.keys(units);
      
      keys.forEach((key, index) => {
        const name = unitLabels[key] || key;
        fromSelect.add(new Option(name, key));
        toSelect.add(new Option(name, key));
      });
      if (keys.length > 1) toSelect.selectedIndex = 1;
    }

    convert();
  }

  function convert() {
    const cat = document.getElementById('category').value;
    const val = parseFloat(document.getElementById('inputValue').value);
    const from = document.getElementById('fromUnit').value;
    const to = document.getElementById('toUnit').value;
    
    const resultEl = document.getElementById('resultValue');
    const formulaEl = document.getElementById('formulaText');

    if (isNaN(val)) {
      resultEl.innerText = "0";
      formulaEl.innerText = "Please enter a valid number";
      return;
    }

    let res = 0;

    if (cat === 'temperature') {
      res = convertTemperature(val, from, to);
      formulaEl.innerText = getTempFormula(from, to);
    } else {
      const baseVal = val * unitData[cat][from];
      res = baseVal / unitData[cat][to];
      formulaEl.innerText = `1 ${unitLabels[from] || from} = ${(unitData[cat][from] / unitData[cat][to]).toFixed(6)} ${unitLabels[to] || to}`;
    }

    // Format output
    let formattedResult = Number.isInteger(res) ? res : parseFloat(res.toFixed(6));
    resultEl.innerText = `${formattedResult}`;
  }

  function convertTemperature(val, from, to) {
    if (from === to) return val;
    let tempInC = 0;

    if (from === 'celsius') tempInC = val;
    else if (from === 'fahrenheit') tempInC = (val - 32) * (5 / 9);
    else if (from === 'kelvin') tempInC = val - 273.15;

    if (to === 'celsius') return tempInC;
    if (to === 'fahrenheit') return (tempInC * 9 / 5) + 32;
    if (to === 'kelvin') return tempInC + 273.15;
  }

  function getTempFormula(from, to) {
    if (from === to) return "Same units selected";
    if (from === 'celsius' && to === 'fahrenheit') return "(°C × 9/5) + 32 = °F";
    if (from === 'fahrenheit' && to === 'celsius') return "(°F − 32) × 5/9 = °C";
    if (from === 'celsius' && to === 'kelvin') return "°C + 273.15 = K";
    if (from === 'kelvin' && to === 'celsius') return "K − 273.15 = °C";
    if (from === 'fahrenheit' && to === 'kelvin') return "(°F − 32) × 5/9 + 273.15 = K";
    if (from === 'kelvin' && to === 'fahrenheit') return "(K − 273.15) × 9/5 + 32 = °F";
  }

  function swapUnits() {
    const from = document.getElementById('fromUnit');
    const to = document.getElementById('toUnit');
    const temp = from.value;
    from.value = to.value;
    to.value = temp;
    convert();
  }

  function resetAll() {
    document.getElementById('inputValue').value = 1;
    document.getElementById('category').selectedIndex = 0;
    loadUnits();
  }

  function copyResult() {
    const resText = document.getElementById('resultValue').innerText;
    const toText = document.getElementById('toUnit').selectedOptions[0].text;
    const copyBtn = document.getElementById('copyBtn');

    navigator.clipboard.writeText(`${resText} ${toText}`).then(() => {
      copyBtn.innerText = "Copied!";
      setTimeout(() => { copyBtn.innerText = "Copy Result"; }, 2000);
    });
  }

  // Initialize on page load
  window.onload = loadUnits;
</script>

</body>
</html>
